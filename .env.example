# Copy to .env: cp .env.example .env
POSTGRES_USER=f1
POSTGRES_PASSWORD=change_me
POSTGRES_DB=f1
DATABASE_URL=postgresql://f1:change_me@127.0.0.1:5432/f1
TEST_DATABASE_URL=postgresql://f1:change_me@127.0.0.1:5432/f1_test

# Your key from console.anthropic.com. Never commit the real one.
ANTHROPIC_API_KEY=

# Questions per minute per visitor on /ask. 0 turns the rate limit off for local development. Never set 0 on a public server.
ASK_RATE_LIMIT_PER_MINUTE=5

# Website addresses allowed to call the API from a browser, comma-separated. The Vite dev server by default.
CORS_ORIGINS=http://localhost:5173
